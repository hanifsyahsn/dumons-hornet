{
  "name": "dumons-hornet",
  "version": "1.19.1",
  "private": true,
  "description": "Dumons Coating - Hornet lineup website (hornet.dumonscoating.com)",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon --watch src --ext js,jsx,ts,tsx,css,json --exec \"npm run build && node dist/server/server.js\"",
    "build:client": "webpack --config webpack.client.js",
    "build:server": "webpack --config webpack.server.js",
    "build": "npm run build:client && npm run build:server",
    "build:static": "cross-env NODE_ENV=production npm run build && node dist/server/prerender.js",
    "start": "cross-env NODE_ENV=production node dist/server/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "autoprefixer": "^10.4.22",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "ignore-loader": "^0.1.2",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss-custom-media": "^11.0.6",
    "postcss-import": "^16.1.1",
    "postcss-loader": "^8.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.29.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-loader": "^10.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "nodemon": "^3.1.10",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  }
}
